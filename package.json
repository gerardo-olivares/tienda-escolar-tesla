{
  "name": "tienda-escolar-tesla",
  "version": "1.0.0",
  "description": "Tienda escolar del Colegio Tesla: API con Node.js, Express, MongoDB (Mongoose) y JWT, con pruebas en Jest y despliegue en Vercel",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "Gerardo Olivares Mijares",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/middleware/**/*.js",
      "src/routes/**/*.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  }
}
